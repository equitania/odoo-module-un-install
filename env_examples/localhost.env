# Odoo Server Configuration - Local Development Example
# Configuration for local Odoo development server

# Local server URL (no HTTPS)
ODOO_URL=http://localhost

# Local development port
ODOO_PORT=8069

# Development user
ODOO_USER=admin

# Development password (optional)
ODOO_PASSWORD=admin

# Development database
ODOO_DATABASE=odoo_dev

# Keyring for local development (optional)
ODOO_USE_KEYRING=false
