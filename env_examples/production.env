# Odoo Server Configuration - Production Example
# This file demonstrates .env configuration format for Odoo connections
# Copy this file and customize for your environment

# Server URL (required)
# For HTTPS servers, include the protocol
ODOO_URL=https://odoo.example.com

# Server Port (optional, default: 0 which auto-detects)
# 443 for HTTPS, 8069 for local development
ODOO_PORT=443

# Admin User (required)
# User must have sufficient rights for module management
ODOO_USER=admin

# Password (optional - can be entered interactively or stored in keyring)
# Leave empty to use keyring or interactive prompt
ODOO_PASSWORD=

# Database Name (optional - can be selected interactively)
# Leave empty to select from available databases
ODOO_DATABASE=production_db

# Use System Keyring (optional, default: true)
# Set to 'true' to store password securely in system keyring
# Set to 'false' to always prompt for password
ODOO_USE_KEYRING=true
