# Odoo Server Configuration Template
# Copy this file to create your own .env configuration
#
# Required fields: ODOO_URL, ODOO_USER
# Optional fields: All others

# ============================================
# REQUIRED CONFIGURATION
# ============================================

# Server URL (required)
# Examples:
#   - HTTPS remote: https://odoo.example.com
#   - HTTP local: http://localhost
ODOO_URL=

# Admin User (required)
# User with module management rights
ODOO_USER=

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Server Port (optional, default: auto-detect)
# Common values:
#   - 443 (HTTPS default)
#   - 8069 (Odoo default)
#   - 80 (HTTP default)
ODOO_PORT=0

# Password (optional)
# If empty, will use keyring or interactive prompt
# Not recommended to store passwords in .env files for production
ODOO_PASSWORD=

# Database Name (optional)
# If empty, will select from available databases interactively
# If only one database exists, it will be auto-selected
ODOO_DATABASE=

# Use System Keyring (optional, default: true)
# Options: true, false, 1, 0, yes, no
# When true: password stored securely in system keyring
# When false: password must be provided each time or in ODOO_PASSWORD
ODOO_USE_KEYRING=true
